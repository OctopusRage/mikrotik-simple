# Copy to .env (docker compose) or ~/.config/mikrotik-dash/env (install.sh).

# Router SSH access (key auth; import the public key on the router with
# /user ssh-keys import).
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PORT=22
# Docker only: private key on the host to mount into the container.
SSH_KEY_FILE=~/.ssh/id_rsa

# Network
LAN_IFACE=bridge
LAN_CIDR=192.168.88.0/24
ROUTER_IP=192.168.88.1
# Names for clients with a static IP (no DHCP lease), as JSON.
STATIC_NAMES='{"192.168.88.2": "Orange Pi"}'

# Dashboard
PORT=8088
# Login password. Leave empty for no login (only sensible bound to 127.0.0.1).
DASH_PASSWORD=change-me
